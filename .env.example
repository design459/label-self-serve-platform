# Supabase project (create a fresh dedicated project for this app — do not
# reuse an existing project you don't own outright; see README "Deploying").
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never exposed to the browser, never prefixed NEXT_PUBLIC_.
# Used by every Route Handler in app/api/** to talk to Postgres/Storage.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage bucket for uploaded logos + rendered proofs. Create it (private,
# not public) in the Supabase dashboard before first use.
SUPABASE_STORAGE_BUCKET=label-assets

# Set to "true" only if you need to force the serverless Chromium code path
# while testing locally. Leave unset for normal local dev (uses your
# machine's installed Chrome/Edge) and for Netlify (auto-detected).
FORCE_SERVERLESS_CHROMIUM=

# Only needed if @sparticuz/chromium's bundled binary ever exceeds Netlify's
# function size limit — see lib/launchBrowser.ts.
CHROMIUM_REMOTE_PACK_URL=

# Anthropic key — powers the QA compliance check, the AI description draft, and
# the Sinhala/Tamil translation. Without it those features fail at runtime.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Gmail SMTP — the ONLY outbound-email path (staff access-code relay, etc.).
# SMTP_APP_PASSWORD is a Google App Password, not the account password.
SMTP_EMAIL=your-gmail-address@gmail.com
SMTP_APP_PASSWORD=your-gmail-app-password

# SPINE single sign-on (staff side). See docs/SPINE-SSO-SPEC.md.
# ATLAS_BRIDGE_SECRET is copied from SPINE (ask the SPINE admin for the value).
# LABELGEN_SESSION_SECRET signs this app's own session cookie and must be
# GENERATED here, not copied: `openssl rand -base64 48`.
ATLAS_BRIDGE_SECRET=copied-from-spine
LABELGEN_SESSION_SECRET=generate-with-openssl-rand-base64-48
